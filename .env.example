# Copy this file to .env and fill in real values once you have them.
# Nothing here is required to run the site locally.

# Analytics (e.g. Plausible, Fathom, GA4) — optional, add when you pick one
PUBLIC_ANALYTICS_ID=

# Affiliate network publisher IDs — add once your applications are approved.
# Actual per-category affiliate URLs live in content/affiliate-links.json,
# not here, so non-secret link data stays easy to edit without touching env vars.
PUBLIC_AWIN_PUBLISHER_ID=
